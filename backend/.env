# Environment Variables - Copy this to .env and fill in your values
# NEVER commit .env to Git - it contains sensitive data!

# Database Configuration
DATABASE_URL=sqlite:///./mascot.db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mascot_db

# API Configuration
ENVIRONMENT=development
DEBUG=True
API_TITLE=MASCOT mHealth API

# Security
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI/LLM Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Logging
LOG_LEVEL=INFO

# CORS (Frontend URLs)
FRONTEND_URL=http://localhost:3000
EXPO_URL=http://localhost:19000
